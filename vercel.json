{
  "functions": {
    "api/ask.js": {
      "maxDuration": 120
    },
    "api/chat.js": {
      "maxDuration": 45
    },
    "api/brief.js": {
      "maxDuration": 60
    },
    "api/lead.js": {
      "maxDuration": 30
    },
    "api/sim.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/brief/:id",
      "destination": "/brief.html"
    },
    {
      "source": "/book/:id",
      "destination": "/api/book?b=:id"
    },
    {
      "source": "/how-we-work",
      "destination": "/index.html"
    },
    {
      "source": "/packages",
      "destination": "/index.html"
    }
  ]
}
